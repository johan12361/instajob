{
	"name": "instajob",
	"version": "0.1.2",
	"description": "A lightweight scheduler that polls your database and fires jobs at the right time — no cron syntax required.",
	"keywords": [
		"scheduler",
		"job",
		"queue",
		"cron",
		"polling",
		"timer",
		"task"
	],
	"author": "johan12361",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/johan12361/instajob"
	},
	"homepage": "https://github.com/johan12361/instajob#readme",
	"bugs": {
		"url": "https://github.com/johan12361/instajob/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"playground": "bun playground/playground.ts",
		"lint": "biome lint src",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "bun typecheck && bun lint && bun test:run && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "1.3.12",
		"@vitest/coverage-v8": "4.1.4",
		"tsup": "8.5.1",
		"typescript": "7.0.2",
		"vitest": "4.1.4"
	}
}
